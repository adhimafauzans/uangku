{
  "cleanUrls": true,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/src/(.*)", "dest": "/src/$1" },
    { "src": "/node_modules/(.*)", "dest": "/node_modules/$1" },
    { "src": "/@vite/(.*)", "dest": "/@vite/$1" },
    { "src": "/@id/(.*)", "dest": "/@id/$1" },
    { "src": "/@fs/(.*)", "dest": "/@fs/$1" },
    { "src": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|json|html)", "dest": "/$1.$2" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
